<?xml version="1.0" encoding="utf-8"?>
<!--
    Okapi's own connections, such as search suggestions. Pages don't go through it: GeckoView has
    its own network stack, which loads http:// pages people ask for (a router, a NAS, an intranet
    site) and checks certificates against Mozilla's list (ADR 0006). Typed addresses still default
    to https:// (AddressInput).
-->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
