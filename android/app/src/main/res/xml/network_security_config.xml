<?xml version="1.0" encoding="utf-8"?>
<!--
    Okapi's own connections, which are search suggestions only, all over https://. Pages don't go
    through it: GeckoView has its own network stack, which loads http:// pages people ask for (a
    router, a NAS, an intranet site) and checks certificates against Mozilla's list (ADR 0006).
    Android still lets http:// to the device itself through, which tests use.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
